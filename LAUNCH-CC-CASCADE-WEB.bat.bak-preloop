@echo off
REM ============================================================
REM  One-click launcher — Cascade WEB (personal live service) CC stream
REM  Double-click to start CC working the "needs-cc-web" queue in Jira CAS.
REM  Builds real auth + database + monitoring + email for LCP2/cascade-web.
REM  Claims -> builds -> verifies (dry-run) -> ships -> flags needs-lee,
REM  then stops when the queue is empty. Relaunch to run a new batch.
REM ============================================================

REM --- Repo location (convention: C:\dev\<repo>) ---
set "REPO=C:\dev\cascade-web"

if not exist "%REPO%" (
  echo Repo folder not found: %REPO%
  echo Create it first ^(see SETUP-cascade-web.md step 3^):
  echo   fork/template LCP2/cascade-movies -^> LCP2/cascade-web, then:
  echo   git clone https://github.com/LCP2/cascade-web.git "%REPO%"
  pause
  exit /b 1
)

start "CC Cascade WEB" powershell -NoExit -Command "Set-Location '%REPO%'; claude --dangerously-skip-permissions 'Follow CC_AUTONOMY_CASCADE_WEB.md'"
