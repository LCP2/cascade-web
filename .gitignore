.playwright-mcp/
__pycache__/
*.pyc

# CAS-232: installed by npm for the Playwright suite; never committed.
node_modules/
playwright-report/
test-results/

# CAS-574: the CC worker builds in git worktrees, and one of them is created INSIDE the repo
# (C:\Dev\cascade-web\worktrees\<ticket>). Each is a full ~80MB checkout with its own node_modules.
# Untracked-but-not-ignored means one `git add -A` commits the lot to staging, and auto-promote puts it
# straight on main. Nothing in qa.yml would catch it — it tests the app, not the tree.
worktrees/

# CAS-794: written fresh by every `npm run test:agents` run; local artefact, never committed.
qa-agents-report.txt

# CAS-825: written fresh by every `python -m monitor --dry-run` run; local artefact, never committed.
monitor-dryrun-hits.txt

# CAS-870: stale git lock files a worker run can leave behind; never committed.
.lock_trash/

# CAS-872: generated by _sync_ios_www() in poc_pipeline.py on every build (a byte-identical mirror of
# index.html/config.js/etc for Capacitor); ios-testflight.yml regenerates it in CI before the sync.
www/
